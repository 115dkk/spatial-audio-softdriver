;
; HDMI interface layout adapted from
; audio/sysvad/TabletAudioSample/ComponentizedAudioSample.inx at
; windows-driver-samples commit 2dc3fd3a0cc84a2933f2194e7ec0871584979071.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/12/2026,1.0.0.0
CatalogFile = bioatmos.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
bioatmos.sys = 1

[DestinationDirs]
BioAtmos.CopyFiles = 13

[Manufacturer]
%MfgName% = BioAtmos,NTamd64.10.0...19041,NTarm64.10.0...19041

[BioAtmos.NTamd64.10.0...19041]
%BioAtmos.DeviceDesc% = BioAtmos_Device,Root\BioAtmos

[BioAtmos.NTarm64.10.0...19041]
%BioAtmos.DeviceDesc% = BioAtmos_Device,Root\BioAtmos

[BioAtmos_Device.NT]
Include   = ks.inf,wdmaudio.inf
Needs     = KS.Registration,WDMAUDIO.Registration
CopyFiles = BioAtmos.CopyFiles

[BioAtmos.CopyFiles]
bioatmos.sys

[BioAtmos_Device.NT.Interfaces]
; Endpoint 0 WaveRT interface: these reference strings must equal the
; corresponding KSNAME strings used by the miniport registration.
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveHdmi0%,BioAtmos.I.WaveHdmi0
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveHdmi0%,BioAtmos.I.WaveHdmi0
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveHdmi0%,BioAtmos.I.WaveHdmi0
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyHdmi0%,BioAtmos.I.TopologyHdmi0
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyHdmi0%,BioAtmos.I.TopologyHdmi0

; Endpoint 1 is provisioned in the package even when Parameters\SecondEndpoint
; disables its miniport at the next device start.
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveHdmi1%,BioAtmos.I.WaveHdmi1
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveHdmi1%,BioAtmos.I.WaveHdmi1
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveHdmi1%,BioAtmos.I.WaveHdmi1
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyHdmi1%,BioAtmos.I.TopologyHdmi1
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyHdmi1%,BioAtmos.I.TopologyHdmi1

[BioAtmos.I.WaveHdmi0]
AddReg = BioAtmos.I.WaveHdmi0.AddReg

[BioAtmos.I.WaveHdmi0.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Endpoint0Name%

[BioAtmos.I.TopologyHdmi0]
AddReg = BioAtmos.I.TopologyHdmi0.AddReg

[BioAtmos.I.TopologyHdmi0.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Endpoint0Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[BioAtmos.I.WaveHdmi1]
AddReg = BioAtmos.I.WaveHdmi1.AddReg

[BioAtmos.I.WaveHdmi1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Endpoint1Name%

[BioAtmos.I.TopologyHdmi1]
AddReg = BioAtmos.I.TopologyHdmi1.AddReg

[BioAtmos.I.TopologyHdmi1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Endpoint1Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[BioAtmos_Device.NT.Services]
AddService = bioatmos,0x00000002,BioAtmos_Service_Inst

[BioAtmos_Service_Inst]
DisplayName   = %BioAtmos.ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bioatmos.sys
AddReg        = BioAtmos_Service_Parameters

[BioAtmos_Service_Parameters]
HKR,Parameters,SecondEndpoint,0x00010001,1
HKR,Parameters,FormatMask0,0x000B0001,6f,00,00,00,00,00,00,00
HKR,Parameters,FormatMask1,0x000B0001,6f,00,00,00,00,00,00,00
HKR,Parameters,WritePacket,0x00010001,0

[BioAtmos_Device.NT.HW]
AddReg = BioAtmos_Device.HW.AddReg

[BioAtmos_Device.HW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x00010001,0x0000001D

[Strings]
; Non-localizable identifiers.
Proxy.CLSID       = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO  = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"

KSNAME_WaveHdmi0     = "WaveHdmi0"
KSNAME_TopologyHdmi0 = "TopologyHdmi0"
KSNAME_WaveHdmi1     = "WaveHdmi1"
KSNAME_TopologyHdmi1 = "TopologyHdmi1"

PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

; Localizable labels.
ProviderName          = "115dkk"
MfgName               = "115dkk"
DiskName              = "BIO Atmos Driver Disk"
BioAtmos.DeviceDesc   = "BIO Atmos Virtual HDMI"
BioAtmos.ServiceDesc  = "BIO Atmos Virtual HDMI Driver"
Endpoint0Name         = "BIO Atmos Virtual HDMI"
Endpoint1Name         = "BIO Atmos Virtual HDMI 2"
